# Database (PostgreSQL). If unset, the app uses an ephemeral in-process store
# clearly labelled in the UI — set this for real persistence.
DATABASE_URL=postgres://maintainer:maintainer@localhost:5432/maintaineros

# GitHub token used for API access when the user does not supply one per-task.
GITHUB_TOKEN=

# LLM configuration (OpenAI-compatible chat-completions endpoint).
# Optional: everything below can be set from the Settings UI instead
# (stored overrides apply immediately, no restart; secrets are encrypted
# with SETTINGS_SECRET). Env vars remain as defaults/fallbacks.
# Presets:
#   Gemini:  base https://generativelanguage.googleapis.com/v1beta/openai  model gemini-3.5-flash
#   OpenAI:  base https://api.openai.com/v1                              model gpt-4o-mini
#   Ollama:  base http://localhost:11434/v1                              model qwen3:8b
# If unset, stages run on deterministic static analysis only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Master secret for encrypting API keys saved via the Settings UI.
# Required before the UI can store LLM_API_KEY or GITHUB_TOKEN.
SETTINGS_SECRET=

# Local working directory for cloned repositories under investigation.
WORKSPACE_DIR=
